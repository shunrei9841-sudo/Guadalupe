      "source": [
        "import numpy as np\n",
        "\n",
        "# Configuración\n",
        "n_simulaciones = 1000000  # Un millón de muestras para alta precisión\n",
        "\n",
        "# 1. Generar U ~ Uniforme(0, 1)\n",
        "u = np.random.random(n_simulaciones)\n",
        "\n",
        "# 2. Transformada Inversa para obtener X\n",
        "# Basado en F(x) = 1 - (1/3)^x\n",
        "x = np.ceil(np.log(1 - u) / np.log(1/3))\n",
        "\n",
        "# 3. Calcular g(X) = sqrt(X)\n",
        "raiz_x = np.sqrt(x)\n",
        "\n",
        "# 4. Resultados de Monte Carlo\n",
        "estimacion = np.mean(raiz_x)\n",
        "error_estandar = np.std(raiz_x) / np.sqrt(n_simulaciones)\n",
        "\n",
        "print(f\"Resultados de la simulación:\")\n",
        "print(f\"E[√X] ≈ {estimacion:.6f}\")\n",
        "print(f\"Error estándar: {error_estandar:.6f}\")"
